<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" on EVERY line, and it is not optional here.
             docker-compose passes .env into the container with `env_file`, so
             APP_ENV=local, DB_DATABASE=blog and friends are real environment
             variables inside the container. PHPUnit will NOT overwrite an
             existing environment variable unless force="true" - so without it
             the suite silently runs as APP_ENV=local against the DEVELOPMENT
             database, and RefreshDatabase happily wipes your real posts. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>

        <!-- bcrypt is deliberately slow; the production value of 12 would add
             seconds to every test that creates a user. -->
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>

        <env name="BROADCAST_CONNECTION" value="null" force="true"/>

        <!-- PostgreSQL, not the usual sqlite :memory: - the app uses
             PostgreSQL-specific SQL (ILIKE in Post::scopeSearch) and
             timestamptz columns. Tests on SQLite would pass while production
             broke, which is worse than no test at all.

             DB_HOST is deliberately NOT set, so the suite follows whichever
             database mode .env selects. The database itself is created by
             docker/postgres/init-test-db.sh (container mode) or by
             scripts/setup-host-postgres.sh (host mode). -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="blog_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>

        <!-- Keeps tests isolated and fast: no real cache store, no queue
             worker (jobs run inline), no mail leaving the machine. -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>

        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
