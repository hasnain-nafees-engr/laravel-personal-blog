# =============================================================================
# Copy me:  cp .env.example .env   (then: make up)
# Every variable is commented. NEVER commit the real .env.
# =============================================================================

# Display name - used in page titles, mail sender name, cache-key prefix.
APP_NAME="Hasnain's Blog"
# local | production. Controls debug pages, cache warming in the entrypoint, etc.
APP_ENV=local
# Encryption key for sessions/cookies. Left empty on purpose: generated on
# first boot in dev. In production, set it yourself: php artisan key:generate --show
APP_KEY=
# NEVER true in production - it leaks stack traces and config to visitors.
APP_DEBUG=true
# Public URL of the site. Port must match APP_PORT below.
APP_URL=http://localhost:8000

# UI language / fallback / fake-data locale for seeders.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Where "php artisan down" stores the maintenance flag.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Cost factor for password hashing (12 = current sensible default).
BCRYPT_ROUNDS=12

# Logging: single file in dev; see config/logging.php for channels.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE - two modes, switch by editing THIS FILE ONLY, then: make down && make up
#
# MODE A (default): containerized PostgreSQL - zero host setup, works anywhere.
#   DB_HOST=postgres  and  COMPOSE_PROFILES=db
#
# MODE B: your HOST PostgreSQL (run once: sudo ./scripts/setup-host-postgres.sh)
#   DB_HOST=host.docker.internal  and  COMPOSE_PROFILES=   (empty!)
#
# Trade-offs: A is reproducible and isolated (own data volume, easy reset);
# B reuses the Postgres you already run (one DB engine, your existing tools,
# data survives `docker volume` cleanups).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=blog
DB_USERNAME=blog
# Change me in a real deployment.
DB_PASSWORD=secret

# Docker Compose reads this file too. "db" starts the postgres container,
# "cache" adds redis (e.g. COMPOSE_PROFILES=db,cache). Empty = host DB mode.
COMPOSE_PROFILES=db

# Host port nginx listens on (8080 is taken on this machine, so 8000).
APP_PORT=8000
# Vite dev-server port (hot reload).
VITE_PORT=5173
# Mailpit web UI port (dev only).
MAILPIT_UI_PORT=8025

# Your host UID/GID so bind-mounted files stay owned by you (see: id -u).
WWWUSER=1000
WWWGROUP=1000

# Xdebug in the dev container: off | debug (step debugging) | coverage (tests).
XDEBUG_MODE=off

# Sessions live in the DB (survives container restarts; no extra service).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded files: "local" = storage/app/private, "public" = storage/app/public.
FILESYSTEM_DISK=local

# Queued jobs go to the jobs table; the "queue" container works them off.
# Switch to redis (with COMPOSE_PROFILES=db,cache) for higher throughput.
QUEUE_CONNECTION=database

# Cache lives in the DB cache table - fine at blog scale, no extra service.
CACHE_STORE=database
# CACHE_PREFIX=

# Only used when CACHE_STORE/QUEUE_CONNECTION/SESSION_DRIVER point at redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev default: Mailpit catches everything - UI at http://localhost:8025.
# (Set MAIL_MAILER=log to just write mails into laravel.log instead.)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@hasnains.blog"
MAIL_FROM_NAME="${APP_NAME}"

# Unused (no cloud storage in scope) - kept because config/filesystems.php reads them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Exposed to the frontend build (import.meta.env.VITE_*).
VITE_APP_NAME="${APP_NAME}"
