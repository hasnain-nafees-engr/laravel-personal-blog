includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # NOTE: do not add a `bootstrapFiles` key here. Larastan's extension.neon
    # already sets it to its own bootstrap.php (which boots the application and
    # defines LARAVEL_VERSION), and a bootstrapFiles entry in this file
    # REPLACES that list rather than adding to it - the run then dies with
    # `Undefined constant Larastan\Larastan\LARAVEL_VERSION`.

    # Level 5 is the project's floor (the brief's requirement). Larastan
    # teaches PHPStan about Laravel's magic - Eloquent builders, facades,
    # relations - which plain PHPStan would flag on nearly every line.
    level: 5

    paths:
        - app
        - config
        - database
        - routes

    # Makes $post->titel an error rather than a silent null at runtime.
    checkModelProperties: true

    # NOTE: there is deliberately no ignoreErrors list.
    #
    # There used to be one entry here, silencing "undefined static method
    # Image::read()" on the claim that the facade merely lacked a docblock.
    # That claim was wrong - read() is Intervention Image v3's name, and the
    # job crashed on the first real upload. The analyser was right and the
    # suppression hid a genuine bug. Ignore rules earn their place only with
    # evidence, not with a plausible-sounding comment.
